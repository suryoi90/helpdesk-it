<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Form Pengajuan Perbaikan IT - PT Global Dispomedika</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-[#f0f4f9] min-h-screen py-8 px-4 sm:px-6">
  <div class="max-w-2xl mx-auto space-y-4">
    
    <!-- Banner Header Form Pengajuan Perbaikan IT -->
    <div class="bg-white rounded-2xl shadow-sm border-t-4 border-indigo-600 p-6 sm:p-8 text-center">
      
      <!-- Logo Perusahaan (200px) -->
      <div class="mb-4 flex justify-center items-center">
        <img src="https://lh3.googleusercontent.com/d/1fl09tFwRU-NavWdZ8jKG47IU7M6MqSJr" 
             alt="Global Dispomedika" 
             style="width: 200px; max-width: 100%; height: auto;" 
             class="object-contain mx-auto">
      </div>

      <!-- Badge Sistem -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-indigo-50 border border-indigo-100 text-indigo-700 text-[11px] font-bold rounded-full uppercase tracking-wider mb-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
        IT Repair & Maintenance Portal
      </div>

      <!-- Judul Resmi -->
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-tight mb-1">
        Form Pengajuan Perbaikan IT
      </h1>
      <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">
        PT Global Dispomedika
      </p>

      <p class="text-slate-600 text-sm leading-relaxed max-w-lg mx-auto">
        Formulir resmi pelaporan dan pengajuan perbaikan perangkat hardware/software kerja yang mengalami kerusakan atau memerlukan pemeliharaan teknis.
      </p>

      <div class="mt-4 inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-full bg-rose-50 border border-rose-100 text-rose-600 text-xs font-medium">
        <span class="font-bold text-rose-500">*</span>
        <span>Wajib diisi untuk proses registrasi dan analisa teknisi IT</span>
      </div>
    </div>

    <!-- Alert Sukses Modal -->
    <div id="successModal" class="hidden bg-white border border-green-300 rounded-2xl p-6 shadow-lg text-center space-y-3">
      <div class="w-12 h-12 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto text-xl font-bold">✓</div>
      <h3 class="text-lg font-bold text-gray-800">Pengajuan Perbaikan Berhasil Didaftarkan!</h3>
      <p class="text-sm text-gray-600">Nomor Registrasi Tiket Perbaikan:</p>
      <div id="displayTicketId" class="inline-block bg-indigo-50 text-indigo-700 font-mono font-bold px-5 py-2.5 rounded-xl text-xl border border-indigo-200">
        RPR-XXXX
      </div>
      <p class="text-xs text-gray-600">
        Dokumen resmi telah dikirim ke email pemohon. Tim teknis IT akan segera melakukan pengecekan fisik perangkat.
      </p>
      <div class="pt-3">
        <button onclick="resetFormView()" class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-lg shadow">
          + Ajukan Perbaikan Baru
        </button>
      </div>
    </div>

    <!-- Form Perbaikan IT -->
    <form id="repairForm" class="space-y-4 text-left">
      
      <!-- 1. Identitas Karyawan (Autocomplete) -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition relative">
        <label class="block text-gray-800 font-semibold text-sm mb-1">
          Nama Lengkap / Email / NIK Pemohon <span class="text-red-500">*</span>
        </label>
        <p class="text-xs text-gray-500 mb-2">Ketik nama atau NIK untuk pengisian otomatis</p>
        
        <div class="relative">
          <input type="text" id="employeeInput" name="Nama Lengkap" required autocomplete="off"
            placeholder="Ketik Nama, NIK, atau Email..."
            oninput="handleSearch(this.value)"
            class="w-full border-b border-gray-300 focus:border-indigo-600 outline-none py-2 text-sm text-gray-800 transition">
          
          <div id="autocompleteList" class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-gray-200 rounded-xl shadow-2xl z-50 max-h-60 overflow-y-auto divide-y divide-gray-100"></div>
        </div>

        <div id="selectedEmployeeBadge" class="hidden mt-3 p-3 bg-indigo-50 border border-indigo-200 rounded-xl flex items-center justify-between">
          <div class="text-xs text-indigo-900">
            <span class="font-bold block" id="badgeName">-</span>
            <span class="text-indigo-600" id="badgeDetails">-</span>
          </div>
          <span class="text-xs font-semibold bg-indigo-200 text-indigo-800 px-2 py-1 rounded-md">✓ Data Terverifikasi</span>
        </div>
      </div>

      <!-- 2. Email Pemohon -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-1">
          Email Pemohon <span class="text-red-500">*</span>
        </label>
        <input type="email" id="emailInput" name="Email Pelapor" required placeholder="nama@dispomedika.com"
          class="w-full border-b border-gray-300 focus:border-indigo-600 outline-none py-2 text-sm text-gray-800 transition">
      </div>

      <!-- 3. Departemen -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-2">Department / Team <span class="text-red-500">*</span></label>
        <select id="deptSelect" name="Department/Team" required class="w-full border border-gray-300 rounded-xl p-3 text-sm text-gray-700 outline-none focus:border-indigo-600 bg-white">
          <option value="" disabled selected>-- Pilih Departemen / Tim --</option>
          <option value="Sales">Sales</option>
          <option value="Marketing">Marketing</option>
          <option value="Human Resources">Human Resources</option>
          <option value="Finance">Finance</option>
          <option value="Operational">Operational</option>
          <option value="T&D">T&D</option>
        </select>
      </div>

      <!-- 4. Perangkat yang Diperbaiki -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-2">Perangkat yang Mengalami Kerusakan <span class="text-red-500">*</span></label>
        <select id="selectPerangkat" name="Kategori kendala" required onchange="handleDeviceOther(this.value)" class="w-full border border-gray-300 rounded-xl p-3 text-sm text-gray-700 outline-none focus:border-indigo-600 bg-white">
          <option value="" disabled selected>-- Pilih Perangkat --</option>
          <option value="Laptop / Notebook">Laptop / Notebook</option>
          <option value="PC Komputer / CPU">PC Komputer / CPU</option>
          <option value="Monitor">Monitor</option>
          <option value="Printer / Scanner">Printer / Scanner</option>
          <option value="UPS / Kelistrikan IT">UPS / Kelistrikan IT</option>
          <option value="Perangkat Jaringan (Switch / Router / Wi-Fi)">Perangkat Jaringan (Switch / Router / Wi-Fi)</option>
          <option value="Yang lain:">Yang lain:</option>
        </select>

        <div id="extraPerangkatLainnya" class="hidden mt-3">
          <label class="block text-xs font-semibold text-indigo-700 mb-1">Tuliskan nama perangkat lainnya:</label>
          <input type="text" id="inputPerangkatLainnya" placeholder="Contoh: Barcode Scanner, Mesin Fax, Kabel Proyektor..."
            class="w-full border border-indigo-300 rounded-xl p-3 text-sm text-gray-800 outline-none focus:border-indigo-600 bg-indigo-50/20">
        </div>
      </div>

      <!-- 5. Merk / Tipe / Serial Number / Asset Tag -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-1">
          Merk, Tipe & Nomor Seri (Asset Tag / SN)
        </label>
        <p class="text-xs text-gray-400 mb-2">Contoh: Lenovo ThinkPad L14 / SN: PF2XXXX / Asset: AST-0145</p>
        <input type="text" name="Jenis hardware apa yang mengalami kendala?" placeholder="Tuliskan merk / tipe / nomor seri perangkat..."
          class="w-full border-b border-gray-300 focus:border-indigo-600 outline-none py-2 text-sm text-gray-800">
      </div>

      <!-- 6. Tingkat Urgensi -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-3">Tingkat Urgensi Perbaikan <span class="text-red-500">*</span></label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <label class="border border-gray-200 p-3 rounded-xl flex flex-col items-center cursor-pointer hover:border-indigo-400 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/50">
            <input type="radio" name="Tingkat urgensi" value="Low" required class="mb-1 text-indigo-600">
            <span class="text-xs font-semibold text-gray-700">Low</span>
          </label>
          <label class="border border-gray-200 p-3 rounded-xl flex flex-col items-center cursor-pointer hover:border-indigo-400 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/50">
            <input type="radio" name="Tingkat urgensi" value="Medium" class="mb-1 text-indigo-600">
            <span class="text-xs font-semibold text-gray-700">Medium</span>
          </label>
          <label class="border border-gray-200 p-3 rounded-xl flex flex-col items-center cursor-pointer hover:border-indigo-400 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/50">
            <input type="radio" name="Tingkat urgensi" value="High" class="mb-1 text-indigo-600">
            <span class="text-xs font-semibold text-orange-600">High</span>
          </label>
          <label class="border border-gray-200 p-3 rounded-xl flex flex-col items-center cursor-pointer hover:border-red-400 has-[:checked]:border-red-600 has-[:checked]:bg-red-50/50">
            <input type="radio" name="Tingkat urgensi" value="Critical" class="mb-1 text-red-600">
            <span class="text-xs font-semibold text-red-600">Critical</span>
          </label>
        </div>
      </div>

      <!-- 7. Deskripsi Kronologi Kerusakan -->
      <div class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-1">
          Deskripsi Kronologi Kerusakan & Gejala Kendala <span class="text-red-500">*</span>
        </label>
        <p class="text-xs text-gray-400 mb-2">Jelaskan bagaimana kerusakan terjadi, pesan error yang muncul, atau kondisi fisik perangkat</p>
        <textarea name="Deskripsi Kendala" rows="4" required placeholder="Contoh: Laptop mati total setelah terkena tumpahan air, atau monitor bergaris-garis saat dinyalakan..." class="w-full border-b border-gray-300 focus:border-indigo-600 outline-none py-2 text-sm text-gray-800 resize-none"></textarea>
      </div>

      <!-- 8. Lampiran Foto Bukti Kerusakan Fisik (Upload & Kamera) -->
      <div id="attachmentSection" class="bg-white rounded-2xl shadow-sm p-6 focus-within:ring-2 focus-within:ring-indigo-500 transition">
        <label class="block text-gray-800 font-semibold text-sm mb-1">
          Lampiran Foto/Screenshot: Bukti layar error atau kerusakan fisik <span class="text-red-500 font-bold">*</span>
        </label>
        <p class="text-xs text-gray-500 mb-4">Pilih dari file/galeri atau ambil foto langsung menggunakan kamera</p>
        
        <input type="file" id="fileInput" accept="image/*,.pdf" onchange="handleFileSelect(event)" class="hidden">
        <input type="file" id="cameraMobileInput" accept="image/*" capture="environment" onchange="handleFileSelect(event)" class="hidden">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
          <button type="button" onclick="document.getElementById('fileInput').click()"
            class="flex items-center justify-center space-x-2 py-3 px-4 rounded-xl border-2 border-dashed border-indigo-300 bg-indigo-50/50 hover:bg-indigo-100/50 text-indigo-700 text-sm font-semibold transition">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>Pilih Dari File / Galeri</span>
          </button>

          <button type="button" onclick="openCameraModal()"
            class="flex items-center justify-center space-x-2 py-3 px-4 rounded-xl border-2 border-indigo-600 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>Ambil Foto Fisik</span>
          </button>
        </div>

        <div id="previewContainer" class="hidden p-3 bg-gray-50 border border-gray-200 rounded-xl mt-3 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <img id="previewImage" src="" alt="Preview" class="w-14 h-14 object-cover rounded-lg border border-gray-300">
            <div>
              <div id="previewFileName" class="text-xs font-bold text-gray-800 truncate max-w-[200px]">Foto_Kerusakan.jpg</div>
              <div class="text-[11px] text-green-600 font-semibold">✓ Foto siap dilampirkan</div>
            </div>
          </div>
          <button type="button" onclick="clearAttachment()" class="text-xs text-red-600 hover:text-red-800 font-semibold px-2 py-1 bg-red-50 hover:bg-red-100 rounded-lg">
            Hapus / Ganti
          </button>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-between pt-2">
        <button type="submit" id="btnSubmit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-xl shadow-md transition text-sm flex items-center space-x-2">
          <span id="btnText">Kirim Pengajuan Perbaikan</span>
          <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
        <a href="/" class="text-gray-500 hover:text-gray-700 text-sm font-medium px-4 py-2">Kembali ke Portal Utama</a>
      </div>

    </form>
  </div>

  <!-- MODAL KAMERA INTERAKTIF -->
  <div id="cameraModal" class="hidden fixed inset-0 bg-black/75 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-5 space-y-4 shadow-2xl text-center">
      <div class="flex justify-between items-center">
        <h3 class="font-bold text-gray-800 text-sm">Ambil Foto Fisik Kerusakan</h3>
        <button type="button" onclick="closeCameraModal()" class="text-gray-400 hover:text-gray-600 text-lg font-bold">&times;</button>
      </div>
      <div class="relative bg-black rounded-xl overflow-hidden aspect-video flex items-center justify-center">
        <video id="cameraVideo" autoplay playsinline class="w-full h-full object-cover"></video>
      </div>
      <div class="flex justify-center space-x-3 pt-1">
        <button type="button" onclick="captureCameraPhoto()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl text-sm font-semibold flex items-center space-x-2 shadow">
          <span>Jepret Foto</span>
        </button>
        <button type="button" onclick="closeCameraModal()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold">
          Batal
        </button>
      </div>
    </div>
  </div>

  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbzqyb_Il5JX_Cgw2EzgM857sXucWznafsmDU_kFuu0ZeMVOLx-8gWHr1ueXRFFF7bwo/exec";
    const SHEET_ID = "13VxrMTdeosoyi3dNQZ2Ahm6wlf2dr-zvg9yZ9lAZHt4";

    var employeeData = [];
    var currentAttachment = { fileData: null, fileName: "", fileType: "" };
    var activeCameraStream = null;

    async function loadAllEmployees() {
      try {
        var gvizUrl = "https://docs.google.com/spreadsheets/d/" + SHEET_ID + "/gviz/tq?tqx=out:json&sheet=DATA%20USER";
        var res = await fetch(gvizUrl);
        var text = await res.text();
        var jsonText = text.substring(text.indexOf("{"), text.lastIndexOf("}") + 1);
        var data = JSON.parse(jsonText);

        if (data && data.table && data.table.rows) {
          var list = [];
          data.table.rows.forEach(function(row) {
            var c = row.c;
            if (c) {
              var nik = (c[0] && c[0].v !== null) ? String(c[0].v).trim() : "";
              var nama = (c[1] && c[1].v !== null) ? String(c[1].v).trim() : "";
              var dept = (c[2] && c[2].v !== null) ? String(c[2].v).trim() : "";
              var email = (c[3] && c[3].v !== null) ? String(c[3].v).trim() : "";
              if (nama || nik || email) list.push({ nik: nik, nama: nama, dept: dept, email: email });
            }
          });
          if (list.length > 0) employeeData = list;
        }
      } catch (err) {}
    }

    window.addEventListener("DOMContentLoaded", function() {
      loadAllEmployees();
    });

    function handleDeviceOther(val) {
      document.getElementById("extraPerangkatLainnya").classList.toggle("hidden", val !== "Yang lain:");
    }

    function handleFileSelect(event) {
      var file = event.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(e) {
        setAttachment(e.target.result, file.name, file.type);
      };
      reader.readAsDataURL(file);
    }

    async function openCameraModal() {
      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
        try {
          var stream = await navigator.mediaDevices.getUserMedia({ 
            video: { facingMode: { ideal: "environment" } } 
          });
          activeCameraStream = stream;
          var video = document.getElementById("cameraVideo");
          video.srcObject = stream;
          document.getElementById("cameraModal").classList.remove("hidden");
        } catch (err) {
          document.getElementById("cameraMobileInput").click();
        }
      } else {
        document.getElementById("cameraMobileInput").click();
      }
    }

    function captureCameraPhoto() {
      var video = document.getElementById("cameraVideo");
      var canvas = document.createElement("canvas");
      canvas.width = video.videoWidth || 640;
      canvas.height = video.videoHeight || 480;
      var ctx = canvas.getContext("2d");
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

      var dataUrl = canvas.toDataURL("image/jpeg", 0.85);
      var fileName = "Foto_Perbaikan_" + Date.now() + ".jpg";
      setAttachment(dataUrl, fileName, "image/jpeg");
      closeCameraModal();
    }

    function closeCameraModal() {
      if (activeCameraStream) {
        activeCameraStream.getTracks().forEach(track => track.stop());
        activeCameraStream = null;
      }
      document.getElementById("cameraModal").classList.add("hidden");
    }

    function setAttachment(dataUrl, name, type) {
      currentAttachment.fileData = dataUrl;
      currentAttachment.fileName = name;
      currentAttachment.fileType = type;

      document.getElementById("previewImage").src = dataUrl;
      document.getElementById("previewFileName").innerText = name;
      document.getElementById("previewContainer").classList.remove("hidden");
    }

    function clearAttachment() {
      currentAttachment = { fileData: null, fileName: "", fileType: "" };
      document.getElementById("fileInput").value = "";
      document.getElementById("cameraMobileInput").value = "";
      document.getElementById("previewContainer").classList.add("hidden");
    }

    function handleSearch(query) {
      var listContainer = document.getElementById("autocompleteList");
      if (!query || query.trim().length < 1) {
        listContainer.classList.add("hidden");
        return;
      }
      var q = query.toLowerCase().trim();
      var matches = employeeData.filter(function(emp) {
        return (emp.nama && emp.nama.toLowerCase().indexOf(q) !== -1) || 
               (emp.nik && emp.nik.toLowerCase().indexOf(q) !== -1) || 
               (emp.email && emp.email.toLowerCase().indexOf(q) !== -1);
      });

      listContainer.innerHTML = "";
      if (matches.length === 0) {
        var emptyDiv = document.createElement("div");
        emptyDiv.className = "p-3 text-xs text-gray-400 text-center";
        emptyDiv.textContent = "Data tidak ditemukan (isi manual diizinkan)";
        listContainer.appendChild(emptyDiv);
        listContainer.classList.remove("hidden");
        return;
      }

      matches.forEach(function(emp) {
        var item = document.createElement("div");
        item.className = "p-3 hover:bg-indigo-50 cursor-pointer transition flex items-center justify-between border-b border-gray-100 last:border-0";
        item.innerHTML = `<div><div class="text-sm font-semibold text-gray-800">${emp.nama}</div><div class="text-xs text-gray-500">${emp.dept || "-"} • ${emp.email || "-"}</div></div><span class="text-xs bg-gray-100 font-mono text-gray-600 px-2 py-0.5 rounded">${emp.nik || "ID"}</span>`;
        item.addEventListener("click", function() {
          selectEmployee(emp.nama, emp.nik, emp.dept, emp.email);
        });
        listContainer.appendChild(item);
      });
      listContainer.classList.remove("hidden");
    }

    function selectEmployee(nama, nik, dept, email) {
      document.getElementById("employeeInput").value = nama + (nik ? " (" + nik + ")" : "");
      document.getElementById("emailInput").value = email || "";
      var deptSelect = document.getElementById("deptSelect");
      if (dept) {
        for (var i = 0; i < deptSelect.options.length; i++) {
          if (deptSelect.options[i].value.toLowerCase().indexOf(dept.toLowerCase()) !== -1) {
            deptSelect.selectedIndex = i;
            break;
          }
        }
      }
      document.getElementById("badgeName").innerText = nama + (nik ? " - " + nik : "");
      document.getElementById("badgeDetails").innerText = (dept || "-") + " | " + (email || "-");
      document.getElementById("selectedEmployeeBadge").classList.remove("hidden");
      document.getElementById("autocompleteList").classList.add("hidden");
    }

    document.addEventListener("click", function(e) {
      if (!e.target.closest("#employeeInput") && !e.target.closest("#autocompleteList")) {
        document.getElementById("autocompleteList").classList.add("hidden");
      }
    });

    function resetFormView() {
      document.getElementById("repairForm").reset();
      document.getElementById("repairForm").classList.remove("hidden");
      document.getElementById("successModal").classList.add("hidden");
      clearAttachment();
      document.getElementById("selectedEmployeeBadge").classList.add("hidden");
    }

    document.getElementById("repairForm").addEventListener("submit", async function(e) {
      e.preventDefault();

      if (!currentAttachment.fileData) {
        alert("⚠️ Bukti Foto / Layar error WAJIB dilampirkan sebelum mengirim pengajuan perbaikan!");
        document.getElementById("attachmentSection").scrollIntoView({ behavior: 'smooth' });
        return;
      }

      var btn = document.getElementById("btnSubmit");
      var btnText = document.getElementById("btnText");
      var btnSpinner = document.getElementById("btnSpinner");

      btn.disabled = true;
      btnText.innerText = "Mengirim...";
      btnSpinner.classList.remove("hidden");

      var formData = new FormData(this);
      var dataObj = {};
      formData.forEach(function(val, key) { dataObj[key] = val; });

      dataObj["Jenis pengajuan"] = "Form Pengajuan Perbaikan IT";
      if (dataObj["Kategori kendala"] === "Yang lain:" && document.getElementById("inputPerangkatLainnya").value.trim()) {
        dataObj["Kategori kendala"] = document.getElementById("inputPerangkatLainnya").value.trim();
      }

      dataObj.fileName = currentAttachment.fileName;
      dataObj.fileType = currentAttachment.fileType;
      dataObj.fileData = currentAttachment.fileData;

      try {
        const response = await fetch(API_URL, {
          method: "POST",
          body: JSON.stringify(dataObj)
        });
        const res = await response.json();
        if (res.status === "success") {
          document.getElementById("displayTicketId").innerText = res.ticketId;
          document.getElementById("repairForm").classList.add("hidden");
          document.getElementById("successModal").classList.remove("hidden");
        } else {
          alert("Error: " + res.message);
        }
      } catch (err) {
        alert("Gagal mengirim pengajuan. Periksa koneksi internet Anda.");
      } finally {
        btn.disabled = false;
        btnText.innerText = "Kirim Pengajuan Perbaikan";
        btnSpinner.classList.add("hidden");
      }
    });
  </script>
</body>
</html>
